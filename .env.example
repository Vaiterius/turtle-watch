# Copy to .env and edit. These are example values, not verified network settings.

# Shelly Pill address. Reserve it in your router. Leave empty to run demo-only.
SHELLY_HOST=

# Only needed if the Pill reports more than one temperature component.
SHELLY_TEMPERATURE_ID=

POLL_INTERVAL_SECONDS=300

# Port on the Pi that serves the dashboard.
PORT=8000

# Used for log timestamps and the demo data's daily cycle.
TZ=America/Los_Angeles

# Only if the Pi user that owns ./data is not UID/GID 1000 (check with: id).
# PUID=1000
# PGID=1000
